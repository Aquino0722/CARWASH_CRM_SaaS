# -------------------------
# Frontend - Next.js
# -------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_APP_URL=

# -------------------------
# Backend - .NET API
# -------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

Supabase__Url=
Supabase__AnonKey=
Supabase__ServiceRoleKey=
Supabase__JwtIssuer=
